NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
# public API key (not secret) for the signed Upload Widget
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Optional key pool for extra free accounts (generation + AI Vision only). Repeat _2, _3 ...
CLOUDINARY_POOL_1_CLOUD_NAME=
CLOUDINARY_POOL_1_API_KEY=
CLOUDINARY_POOL_1_API_SECRET=
CLOUDINARY_POOL_2_CLOUD_NAME=
CLOUDINARY_POOL_2_API_KEY=
CLOUDINARY_POOL_2_API_SECRET=
DEMO_ACCESS_CODE=choose_a_code_for_judges
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# optional: live generations per session (default 4) and pool credit floor below which live generation turns off (default 12)
LIVE_GEN_CAP=4
LIVE_GEN_MIN=12
# optional: main's transformation-credit floor (credits used of 25/month) at which live kits pause and the UI shows the showcase (default 21; 0 = live pipeline off)
LIVE_TX_MAX_USED=21
# optional: stop calling the Admin API once this many calls are left in Cloudinary's hourly window (default 5)
ADMIN_API_RESERVE=5
# optional: 1 = send x-s2s-admin-calls debug headers in production too (always on in dev)
S2S_DEBUG_ADMIN=
# optional: 1 = render the kit's AI transformations (background removal, generative fill, recolor) on a key-pool account and store the results in main, so main pays ~0 transformations for them (default off; any pool failure falls back to main)
S2S_OFFLOAD_POOL=
